# =============================================================================
# Gitignore per RL_school - Laboratorio di Reinforcement Learning
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ambienti virtuali
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# File e cartelle generate dal training e test
# Preserva le cartelle runs e gli indici di preferiti e successi per ciascun ambiente
play2learn_lunarlander/runs/*
!play2learn_lunarlander/runs/favorites/
play2learn_lunarlander/runs/favorites/*
!play2learn_lunarlander/runs/favorites/index.json
!play2learn_lunarlander/runs/successi/
play2learn_lunarlander/runs/successi/*
!play2learn_lunarlander/runs/successi/index.json

play2learn_hillclimb/runs/*
!play2learn_hillclimb/runs/favorites/
play2learn_hillclimb/runs/favorites/*
!play2learn_hillclimb/runs/favorites/index.json

# Cartelle runs legacy e file compressi generati
/runs/
/runs_hillclimb/
*.zip

# File temporanei di sistema e IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tmp

# Cartella locale di lavoro legacy
Lunar Lander/

# File di review generati per modelli LLM (usati solo localmente per interrogare modelli AI)
PROMPT_*.txt
codice_*.txt
review_*.txt
*.review.txt
*.dump.txt
