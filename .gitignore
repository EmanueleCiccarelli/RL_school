# =============================================================================
# Gitignore per RL_school - Laboratorio di Reinforcement Learning
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ambienti virtuali
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# File e cartelle generate dal training e test
# Preserva la cartella runs e gli indici di preferiti e successi, ignorando modelli pesanti .zip e video .mp4
runs/*
!runs/favorites/
!runs/favorites/index.json
!runs/successi/
!runs/successi/index.json

# File temporanei di sistema e IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tmp

# Cartella locale di lavoro legacy
Lunar Lander/

# File di review generati per modelli LLM (usati solo localmente per interrogare modelli AI)
PROMPT_CODE_REVIEW*.txt
codice_completo_repo*.txt
review_*.txt
*.review.txt
